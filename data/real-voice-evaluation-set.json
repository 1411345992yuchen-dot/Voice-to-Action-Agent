{
  "meta": {
    "version": "V9.1",
    "title": "真实语音评估一期",
    "description": "把浏览器语音识别、模拟 ASR 假设、人工修正和 Agent 解析结果放在同一张评估表里，用于验证语音交互进入物理任务执行前的确认与纠错策略。"
  },
  "cases": [
    {
      "id": "rv_clean_delivery_001",
      "label": "清晰日常递送",
      "scenario": "用户清楚说出对象和目的地，系统可低风险执行。",
      "expectedCommand": "把桌上的红色杯子拿到厨房台面",
      "sampleTranscript": "把桌上的红色杯子拿到厨房台面",
      "sampleConfidence": 0.91,
      "minConfidence": 0.78,
      "minSimilarity": 0.86,
      "expectedReviewRequired": false,
      "expectedNoExecution": false,
      "expectedObjectId": "red_cup",
      "expectedDestinationId": "kitchen_counter",
      "expectedRisk": "low",
      "expectedClarification": false,
      "expectedConfirmation": false,
      "pmNote": "验证高置信、低风险语音指令能快速进入执行链路。"
    },
    {
      "id": "rv_ambiguous_object_002",
      "label": "对象歧义澄清",
      "scenario": "用户只说杯子，场景里有多个杯子，系统不能直接执行。",
      "expectedCommand": "把杯子拿到厨房",
      "sampleTranscript": "把杯子拿到厨房",
      "sampleConfidence": 0.86,
      "minConfidence": 0.78,
      "minSimilarity": 0.84,
      "expectedReviewRequired": true,
      "expectedNoExecution": false,
      "expectedDestinationId": "kitchen_counter",
      "expectedClarification": true,
      "pmNote": "验证语音识别没问题时，语义层仍要对指代歧义做产品门控。"
    },
    {
      "id": "rv_misrecognition_repair_003",
      "label": "误识别后人工修正",
      "scenario": "ASR 把“杯子”识别成“被子”，需要进入确认区修改后再执行。",
      "expectedCommand": "把桌上的红色杯子拿到厨房台面",
      "sampleTranscript": "把桌上的红色被子拿到厨房台面",
      "correctedCommand": "把桌上的红色杯子拿到厨房台面",
      "sampleConfidence": 0.63,
      "minConfidence": 0.76,
      "minSimilarity": 0.82,
      "expectedReviewRequired": true,
      "expectedNoExecution": false,
      "expectedObjectId": "red_cup",
      "expectedDestinationId": "kitchen_counter",
      "expectedRisk": "low",
      "expectedClarification": false,
      "expectedConfirmation": false,
      "pmNote": "验证低置信或关键名词误识别时，先确认再执行可以降低误触发。"
    },
    {
      "id": "rv_high_risk_medicine_004",
      "label": "老人药盒安全确认",
      "scenario": "涉及老人和药品的高风险递送，即使识别清楚也需要安全确认。",
      "expectedCommand": "把药盒递给老人",
      "sampleTranscript": "把药盒递给老人",
      "sampleConfidence": 0.88,
      "minConfidence": 0.78,
      "minSimilarity": 0.84,
      "expectedReviewRequired": false,
      "expectedNoExecution": false,
      "expectedObjectId": "medicine_box",
      "expectedDestinationId": "elder_seat",
      "expectedRisk": "high",
      "expectedClarification": false,
      "expectedConfirmation": true,
      "pmNote": "验证语音交互不是只追求少打断，高风险任务必须保留确认边界。"
    },
    {
      "id": "rv_false_trigger_005",
      "label": "环境闲聊误触发控制",
      "scenario": "用户提到厨房但没有下达任务，系统应阻止进入执行。",
      "expectedCommand": "厨房那边有点吵你先别动",
      "sampleTranscript": "厨房那边有点吵你先别动",
      "sampleConfidence": 0.74,
      "minConfidence": 0.78,
      "minSimilarity": 0.8,
      "expectedReviewRequired": true,
      "expectedNoExecution": true,
      "pmNote": "验证物理任务场景下必须控制误触发，不能因为听到地点词就行动。"
    },
    {
      "id": "rv_navigation_006",
      "label": "无物体自主导航",
      "scenario": "用户只要求机器人移动到客厅，不应追问移动什么物体。",
      "expectedCommand": "请你移动到客厅",
      "sampleTranscript": "请你移动到客厅",
      "sampleConfidence": 0.9,
      "minConfidence": 0.78,
      "minSimilarity": 0.86,
      "expectedReviewRequired": false,
      "expectedNoExecution": false,
      "expectedIntent": "navigate",
      "expectedObjectId": null,
      "expectedDestinationId": "living_room",
      "expectedRisk": "low",
      "expectedClarification": false,
      "expectedConfirmation": false,
      "pmNote": "验证语音里的移动指令可以被识别为机器人自导航，而不是物体搬运。"
    }
  ]
}
